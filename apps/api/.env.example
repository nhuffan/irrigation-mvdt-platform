APP_NAME=MVDT API
APP_ENV=development

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE

FRONTEND_ORIGIN=http://localhost:3000

# Experimental local retrieval (off by default). Absolute paths recommended.
RAG_LITE_ENABLED=false
# RAG_LITE_ALLOWLIST_PATH=/path/to/ignored/checksum-pinned-allowlist.json
# RAG_LITE_INDEX_DIR=/path/to/ignored/local/index
RAG_LITE_MAX_CONTEXT_CHARS=12000

# Optional local Ollama generation. A separate model-processing grant is required.
RAG_GENERATION_ENABLED=false
RAG_PROVIDER=none
# RAG_OLLAMA_MODEL=your-installed-model:tag
# RAG_GENERATION_AUTHORIZATION_PATH=/path/to/ignored/model-processing-grant.json
RAG_GENERATION_DAILY_LIMIT=20
RAG_GENERATION_TIMEOUT_SECONDS=8

# Local MCP stdio, with a separate disclosure grant for the selected host.
MVDT_MCP_ENABLED=false
# MVDT_MCP_GRANT_PATH=/path/to/ignored/mcp-host-grant.json

# Standalone Streamable HTTP resource server, disabled until deployment is authorized.
MVDT_MCP_REMOTE_ENABLED=false
# MVDT_MCP_REMOTE_URL=https://mcp.example.org/mcp
# MVDT_MCP_REMOTE_ISSUER=https://issuer.example.org/
# MVDT_MCP_REMOTE_PUBLIC_KEY_PATH=/path/to/issuer-rsa-public-key.pem
# MVDT_MCP_REMOTE_GRANT_PATH=/path/to/ignored/remote-disclosure-grant.json
