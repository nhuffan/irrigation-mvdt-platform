NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Secondary observation map only. Without an owner-authorized browser key,
# shows the existing OpenStreetMap street-map fallback (not satellite).
# Values: maptiler | esri | auto (auto prefers configured Esri, then MapTiler).
NEXT_PUBLIC_SATELLITE_PROVIDER=maptiler
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_ARCGIS_API_KEY=
# NEXT_PUBLIC_* keys are public browser credentials, frozen at production build.
# Keep actual keys in .env.local (ignored); restrict origins/referrers in provider console.
